@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix peh: <https://w3id.org/peh/> .
@prefix pehterms: <https://w3id.org/peh/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <https://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wikidata: <https://www.wikidata.org/wiki/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

peh:peh-model.owl.ttl a owl:Ontology ;
    rdfs:label "PEH-Model" ;
    pav:version "0.6.1" ;
    skos:definition "Entity and relation ontology and datamodel for Personal Exposure and Health data" .

pehterms:DataExtract a owl:Class ;
    rdfs:label "DataExtract" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservedValue ;
            owl:onProperty pehterms:observed_values ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observed_values ],
        linkml:ClassDefinition ;
    skos:definition "A set of Observed Values, combined into a data extract" ;
    skos:inScheme peh:peh-model .

pehterms:EntityList a owl:Class ;
    rdfs:label "EntityList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:groupings ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:StudyEntity ;
            owl:onProperty pehterms:study_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:MatrixSubClass ;
            owl:onProperty pehterms:matrix_subclasses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:layouts ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Grouping ;
            owl:onProperty pehterms:groupings ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservationGroup ;
            owl:onProperty pehterms:observation_groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:studies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:stakeholders ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observable_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:data_requests ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:physical_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Project ;
            owl:onProperty pehterms:projects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:import_configs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:matrix_subclasses ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservablePropertyMetadataField ;
            owl:onProperty pehterms:metadata_fields ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Observation ;
            owl:onProperty pehterms:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:study_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservationDesign ;
            owl:onProperty pehterms:observation_designs ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservableProperty ;
            owl:onProperty pehterms:observable_properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:biochementity_subclasses ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DerivedObservation ;
            owl:onProperty pehterms:derived_observations ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:IndicatorSubClass ;
            owl:onProperty pehterms:indicator_subclasses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observation_designs ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservedValue ;
            owl:onProperty pehterms:observed_values ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:metadata_fields ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:BioChemEntitySubClass ;
            owl:onProperty pehterms:biochementity_subclasses ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observation_groups ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Study ;
            owl:onProperty pehterms:studies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:derived_observations ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservationResult ;
            owl:onProperty pehterms:observation_results ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataLayout ;
            owl:onProperty pehterms:layouts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:projects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:indicator_subclasses ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataImportConfig ;
            owl:onProperty pehterms:import_configs ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataRequest ;
            owl:onProperty pehterms:data_requests ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:PhysicalEntity ;
            owl:onProperty pehterms:physical_entities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observed_values ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Stakeholder ;
            owl:onProperty pehterms:stakeholders ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observation_results ],
        linkml:ClassDefinition ;
    skos:definition "A generic top level object for collecting named entities under one root entity" ;
    skos:inScheme peh:peh-model .

pehterms:HomeEnvironment a owl:Class ;
    rdfs:label "HomeEnvironment" ;
    rdfs:subClassOf pehterms:Environment ;
    skos:definition "A home environment relevant to the research, typically related to the at-home exposure of a person" ;
    skos:inScheme peh:peh-model .

pehterms:WorkEnvironment a owl:Class ;
    rdfs:label "WorkEnvironment" ;
    rdfs:subClassOf pehterms:Environment ;
    skos:definition "A work environment relevant to the research, typically related to the at-work or commute exposure of a person" ;
    skos:inScheme peh:peh-model .

pehterms:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:range pehterms:Observation ;
    skos:inScheme peh:peh-model .

pehterms:Geolocation a owl:Class ;
    rdfs:label "Geolocation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:location ],
        pehterms:PhysicalEntity ;
    skos:definition "A geographic location relevant to the Personal Exposure and Health projects or studies" ;
    skos:inScheme peh:peh-model .

pehterms:Indicator a owl:Class ;
    rdfs:label "Indicator" ;
    rdfs:subClassOf pehterms:NamedThing ;
    skos:closeMatch iop:Variable ;
    skos:definition "Any measurable or observable variable that can describe data or context in the Personal Exposure and Health domain" ;
    skos:exactMatch wikidata:Q937228 ;
    skos:inScheme peh:peh-model .

pehterms:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:recruited_in_project ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:recruited_in_project ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Project ;
            owl:onProperty pehterms:recruited_in_project ],
        pehterms:PhysicalEntity ;
    skos:definition "A human subject or stakeholder in Personal Exposure and Health research" ;
    skos:inScheme peh:peh-model .

pehterms:SampleCollection a owl:Class ;
    rdfs:label "SampleCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:constraints ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:sample_id_list ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Sample ;
            owl:onProperty pehterms:sample_id_list ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:constraints ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Matrix ;
            owl:onProperty pehterms:matrix ],
        pehterms:StudyEntity ;
    skos:definition "A collection of samples that is itself also a study entity that observations can be recorded for" ;
    skos:inScheme peh:peh-model .

pehterms:StudyPopulation a owl:Class ;
    rdfs:label "StudyPopulation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ResearchPopulationType ;
            owl:onProperty pehterms:research_population_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:research_population_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:research_population_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:StudyEntity ;
            owl:onProperty pehterms:member_id_list ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:member_id_list ],
        pehterms:StudyEntity ;
    skos:definition "A group of study entities that is itself also a study entity that observations can be recorded for" ;
    skos:inScheme peh:peh-model .

pehterms:StudySubject a owl:Class ;
    rdfs:label "StudySubject" ;
    rdfs:subClassOf pehterms:StudyEntity ;
    skos:definition "A study entity that is a main subject for the study" ;
    skos:inScheme peh:peh-model .

pehterms:StudySubjectGroup a owl:Class ;
    rdfs:label "StudySubjectGroup" ;
    rdfs:subClassOf pehterms:StudyEntity ;
    skos:definition "A group of study subjects that is itself also a study entity that observations can be recorded for" ;
    skos:inScheme peh:peh-model .

pehterms:BioChemRole a owl:Class ;
    rdfs:label "BioChemRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty pehterms:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pehterms:id ],
        linkml:ClassDefinition ;
    skos:closeMatch <http://purl.obolibrary.org/obo/chebi_50906> ;
    skos:definition "A role is particular behaviour which a material entity may exhibit." ;
    skos:inScheme peh:peh-model .

pehterms:CalculationImplementation a owl:Class ;
    rdfs:label "CalculationImplementation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:function_kwargs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:function_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:CalculationResult ;
            owl:onProperty pehterms:function_results ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:function_results ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:CalculationKeywordArgument ;
            owl:onProperty pehterms:function_kwargs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:function_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:function_name ],
        linkml:ClassDefinition ;
    skos:definition "Reference and parameters mapping to the implementation that can perform the intended calculation" ;
    skos:inScheme peh:peh-model .

pehterms:CalculationKeywordArgument a owl:Class ;
    rdfs:label "CalculationKeywordArgument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:imputation_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:QUDTUnit ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:imputation_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:process_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservableProperty ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:process_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ContextualFieldReference ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:process_state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:imputation_state ],
        linkml:ClassDefinition ;
    owl:disjointUnionOf ( [ a owl:Restriction ;
                owl:allValuesFrom xsd:string ;
                owl:onProperty pehterms:value ] [ a owl:Restriction ;
                owl:allValuesFrom owl:Thing ;
                owl:onProperty pehterms:contextual_field_reference ] ) ;
    skos:definition "The definition of a named argument used in the calculation, including the information needed to pick it from the project or study data structure" ;
    skos:inScheme peh:peh-model .

pehterms:CalculationResult a owl:Class ;
    rdfs:label "CalculationResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:round_decimals ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:round_decimals ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ContextualFieldReference ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty pehterms:scale_factor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservableProperty ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:scale_factor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pehterms:round_decimals ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:scale_factor ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:QUDTUnit ;
            owl:onProperty pehterms:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:mapping_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:value_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:contextual_field_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observable_property ],
        linkml:ClassDefinition ;
    skos:definition "The definition for the output the calculation, optionally including mapping information" ;
    skos:inScheme peh:peh-model .

<https://w3id.org/peh/terms/ContactRole#administrative> a owl:Class ;
    rdfs:label "administrative" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

<https://w3id.org/peh/terms/ContactRole#data> a owl:Class ;
    rdfs:label "data" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

<https://w3id.org/peh/terms/ContactRole#general> a owl:Class ;
    rdfs:label "general" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

<https://w3id.org/peh/terms/ContactRole#lead> a owl:Class ;
    rdfs:label "lead" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

<https://w3id.org/peh/terms/ContactRole#legal> a owl:Class ;
    rdfs:label "legal" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

<https://w3id.org/peh/terms/ContactRole#technical> a owl:Class ;
    rdfs:label "technical" ;
    rdfs:subClassOf linkml:PermissibleValue,
        pehterms:ContactRole .

pehterms:ContextAlias a owl:Class ;
    rdfs:label "ContextAlias" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:property_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:property_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:NamedThing ;
            owl:onProperty pehterms:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:property_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:alias ],
        linkml:ClassDefinition ;
    skos:definition "An alternative term as it is used in a known scope or context (e.g. a community, project or study) for any of the entities and its properties" ;
    skos:inScheme peh:peh-model .

pehterms:DataImportSectionMapping a owl:Class ;
    rdfs:label "DataImportSectionMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:section_mapping_links ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataImportSectionMappingLink ;
            owl:onProperty pehterms:section_mapping_links ],
        linkml:ClassDefinition ;
    skos:definition "Configuration for mapping structured data from a known layout to one or more study observations" ;
    skos:inScheme peh:peh-model .

pehterms:DataImportSectionMappingLink a owl:Class ;
    rdfs:label "DataImportSectionMappingLink" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observation_id_list ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:section ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataLayoutSection ;
            owl:onProperty pehterms:section ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Observation ;
            owl:onProperty pehterms:observation_id_list ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:section ],
        linkml:ClassDefinition ;
    skos:definition "Configuration that links a data layout section to one or more observations" ;
    skos:inScheme peh:peh-model .

pehterms:DataLayoutElement a owl:Class ;
    rdfs:label "DataLayoutElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:element_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pehterms:is_observable_entity_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataLayoutElementLink ;
            owl:onProperty pehterms:foreign_key_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:foreign_key_link ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:foreign_key_link ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:element_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:DataLayoutElementType ;
            owl:onProperty pehterms:element_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:element_style ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ObservableProperty ;
            owl:onProperty pehterms:observable_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:is_observable_entity_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:is_observable_entity_key ],
        [ a owl:Restriction ;
