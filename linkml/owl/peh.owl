        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:calculation_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:calculation_implementation_as_json ],
