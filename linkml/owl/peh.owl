    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/peh/terms/LinkType#is_about> <https://w3id.org/peh/terms/LinkType#is_same_as> <https://w3id.org/peh/terms/LinkType#is_part_of> <https://w3id.org/peh/terms/LinkType#is_located_at> ) ;
