    rdfs:label "ObservableEntityType" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/peh/terms/ObservableEntityType#project> <https://w3id.org/peh/terms/ObservableEntityType#organisation> <https://w3id.org/peh/terms/ObservableEntityType#study> <https://w3id.org/peh/terms/ObservableEntityType#environment> <https://w3id.org/peh/terms/ObservableEntityType#location> <https://w3id.org/peh/terms/ObservableEntityType#persongroup> <https://w3id.org/peh/terms/ObservableEntityType#person> <https://w3id.org/peh/terms/ObservableEntityType#samplegroup> <https://w3id.org/peh/terms/ObservableEntityType#sample> <https://w3id.org/peh/terms/ObservableEntityType#dataset> <https://w3id.org/peh/terms/ObservableEntityType#collection_process> <https://w3id.org/peh/terms/ObservableEntityType#lab_analysis_process> <https://w3id.org/peh/terms/ObservableEntityType#model_execution_process> <https://w3id.org/peh/terms/ObservableEntityType#data_process> ) ;
    skos:inScheme peh:peh-model ;
    linkml:permissible_values <https://w3id.org/peh/terms/ObservableEntityType#collection_process>,
        <https://w3id.org/peh/terms/ObservableEntityType#data_process>,
        <https://w3id.org/peh/terms/ObservableEntityType#dataset>,
        <https://w3id.org/peh/terms/ObservableEntityType#environment>,
        <https://w3id.org/peh/terms/ObservableEntityType#lab_analysis_process>,
        <https://w3id.org/peh/terms/ObservableEntityType#location>,
        <https://w3id.org/peh/terms/ObservableEntityType#model_execution_process>,
        <https://w3id.org/peh/terms/ObservableEntityType#organisation>,
        <https://w3id.org/peh/terms/ObservableEntityType#person>,
        <https://w3id.org/peh/terms/ObservableEntityType#persongroup>,
        <https://w3id.org/peh/terms/ObservableEntityType#project>,
        <https://w3id.org/peh/terms/ObservableEntityType#sample>,
        <https://w3id.org/peh/terms/ObservableEntityType#samplegroup>,
        <https://w3id.org/peh/terms/ObservableEntityType#study> .

pehterms:StudyEntity a owl:Class ;
    rdfs:label "StudyEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pehterms:StudyEntityLink ;
            owl:onProperty pehterms:study_entity_links ],
        [ owl:unionOf ( pehterms:ObservationGroup pehterms:Project pehterms:SampleCollection pehterms:Study pehterms:StudyPopulation pehterms:StudySubject pehterms:StudySubjectGroup ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:PhysicalEntity ;
            owl:onProperty pehterms:physical_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:study_entity_links ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:physical_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:physical_entity ],
        pehterms:NamedThing ;
    skos:definition "Any entity carrying data or context relevant to a Personal Exposure and Health research project or study" ;
    skos:inScheme peh:peh-model .

pehterms:NamedThing a owl:Class ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:id ],
        [ owl:unionOf ( pehterms:BioChemEntity pehterms:BioChemEntitySubClass pehterms:DataImportConfig pehterms:DataLayout pehterms:DataLayoutSection pehterms:DataRequest pehterms:DataStakeholder pehterms:Grouping pehterms:Indicator pehterms:IndicatorSubClass pehterms:Matrix pehterms:MatrixSubClass pehterms:ObservableProperty pehterms:ObservablePropertyMetadataField pehterms:Observation pehterms:ObservationDesign pehterms:ObservationResult pehterms:PhysicalEntity pehterms:ProcessingAction pehterms:ProcessingStep pehterms:ResearchObjective pehterms:Stakeholder pehterms:StudyEntity ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:ui_label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty pehterms:exact_matches ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pehterms:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:short_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:remark ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty pehterms:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:ui_label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:exact_matches ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:remark ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:remark ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:ui_label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:name ],
        linkml:ClassDefinition ;
    skos:closeMatch schema1:Thing,
        prov:Entity ;
    skos:definition "An abstract model for any of the identifiable entities" ;
    skos:inScheme peh:peh-model .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:context_aliases ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ContextAlias ;
            owl:onProperty pehterms:context_aliases ] ;
    owl:onProperty linkml:mixins ;
    owl:someValuesFrom pehterms:HasContextAliases .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:translations ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:Translation ;
            owl:onProperty pehterms:translations ] ;
    owl:onProperty linkml:mixins ;
    owl:someValuesFrom pehterms:HasTranslations .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pehterms:aliases ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:aliases ] ;
    owl:onProperty linkml:mixins ;
    owl:someValuesFrom pehterms:HasAliases .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ValidationStatus ;
            owl:onProperty pehterms:current_validation_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pehterms:current_validation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:current_validation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pehterms:validation_history ],
        [ a owl:Restriction ;
            owl:allValuesFrom pehterms:ValidationHistoryRecord ;
            owl:onProperty pehterms:validation_history ] ;
    owl:onProperty linkml:mixins ;
    owl:someValuesFrom pehterms:HasValidationStatus .


