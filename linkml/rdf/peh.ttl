<https://w3id.org/peh/terms/NamedThing> a linkml:ClassDefinition ;
    skos:closeMatch "prov:Entity"^^xsd:anyURI,
        "schema:Thing"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    linkml:abstract true ;
    linkml:class_uri "https://w3id.org/peh/terms/NamedThing"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/NamedThing"^^xsd:anyURI ;
    linkml:description "An abstract model for any of the identifiable entities" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/peh/terms/description>,
        <https://w3id.org/peh/terms/exact_matches>,
        <https://w3id.org/peh/terms/id>,
        <https://w3id.org/peh/terms/name>,
        <https://w3id.org/peh/terms/remark>,
        <https://w3id.org/peh/terms/short_name>,
        <https://w3id.org/peh/terms/ui_label> .

<https://w3id.org/peh/terms/description> a linkml:SlotDefinition ;
    skos:exactMatch "http://www.w3.org/2004/02/skos/core#definition"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/description"^^xsd:anyURI ;
    linkml:description "Long form description or definition for the entity." ;
    linkml:domain_of <https://w3id.org/peh/terms/NamedThing> ;
    linkml:owner <https://w3id.org/peh/terms/NamedThing> ;
    linkml:range <https://w3id.org/peh/terms/string> ;
    linkml:slot_uri "http://schema.org/description"^^xsd:anyURI .

<https://w3id.org/peh/terms/exact_matches> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    skos:mappingRelation "http://www.w3.org/2004/02/skos/core#exactMatch"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/exact_matches"^^xsd:anyURI ;
    linkml:domain_of <https://w3id.org/peh/terms/NamedThing> ;
