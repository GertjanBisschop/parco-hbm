<https://w3id.org/peh/terms/id> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    skos:mappingRelation "http://schema.org/identifier"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/id"^^xsd:anyURI ;
    linkml:description "Machine readable, unique identifier; ideally a URI/GUPRI (Globally Unique, Persistent, Resolvable Identifier)." ;
