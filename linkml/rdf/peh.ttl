    linkml:class_uri "https://w3id.org/peh/terms/StudySubject"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/StudySubject"^^xsd:anyURI ;
    linkml:description "A study entity that is a main subject for the study" ;
    linkml:is_a <https://w3id.org/peh/terms/StudyEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/peh/terms/description>,
        <https://w3id.org/peh/terms/exact_matches>,
        <https://w3id.org/peh/terms/id>,
        <https://w3id.org/peh/terms/name>,
        <https://w3id.org/peh/terms/physical_entity>,
        <https://w3id.org/peh/terms/remark>,
        <https://w3id.org/peh/terms/short_name>,
        <https://w3id.org/peh/terms/study_entity_links>,
        <https://w3id.org/peh/terms/ui_label> .

<https://w3id.org/peh/terms/StudySubjectGroup> a linkml:ClassDefinition ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
