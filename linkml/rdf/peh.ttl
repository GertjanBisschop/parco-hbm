    linkml:range <https://w3id.org/peh/terms/uriorcurie> ;
    linkml:slot_uri "http://www.w3.org/2004/02/skos/core#exactMatch"^^xsd:anyURI .

<https://w3id.org/peh/terms/remark> a linkml:SlotDefinition ;
    skos:exactMatch "http://www.w3.org/2004/02/skos/core#note"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    skos:mappingRelation "http://schema.org/comment"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/remark"^^xsd:anyURI ;
    linkml:description "Additional comment, note or remark providing context on the use of an entity or the interpretation of its properties." ;
    linkml:domain_of <https://w3id.org/peh/terms/NamedThing> ;
    linkml:owner <https://w3id.org/peh/terms/NamedThing> ;
    linkml:range <https://w3id.org/peh/terms/string> ;
    linkml:slot_uri "http://schema.org/comment"^^xsd:anyURI .

<https://w3id.org/peh/terms/short_name> a linkml:SlotDefinition ;
    skos:exactMatch "http://www.w3.org/2004/02/skos/core#altLabel"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
