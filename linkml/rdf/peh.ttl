    linkml:definition_uri "https://w3id.org/peh/terms/StudySubjectGroup"^^xsd:anyURI ;
    linkml:description "A group of study subjects that is itself also a study entity that observations can be recorded for" ;
    linkml:is_a <https://w3id.org/peh/terms/StudyEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/peh/terms/description>,
        <https://w3id.org/peh/terms/exact_matches>,
        <https://w3id.org/peh/terms/id>,
        <https://w3id.org/peh/terms/name>,
