    linkml:repr "str" ;
    linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .

<https://w3id.org/peh/terms/derived> linkml:description "Is calculated from other ObservableProperties" .

<https://w3id.org/peh/terms/double> a linkml:TypeDefinition ;
