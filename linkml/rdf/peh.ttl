<https://w3id.org/peh/terms/name> a linkml:SlotDefinition ;
    skos:exactMatch "http://schema.org/name"^^xsd:anyURI,
        "http://www.w3.org/2004/02/skos/core#prefLabel"^^xsd:anyURI ;
