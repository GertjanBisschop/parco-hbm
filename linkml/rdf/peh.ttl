<https://w3id.org/peh/terms/EntityList> a linkml:ClassDefinition ;
    skos:inScheme "https://w3id.org/peh/peh-model"^^xsd:anyURI ;
    linkml:class_uri "https://w3id.org/peh/terms/EntityList"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/peh/terms/EntityList"^^xsd:anyURI ;
